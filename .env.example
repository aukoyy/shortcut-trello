# Required — Shortcut
SHORTCUT_API_TOKEN=
SHORTCUT_OWNER_ID=

# Required — Trello
# KEY = Power-Up API key. TOKEN = generated user Token (not the OAuth Secret).
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=

# Optional
# STATE_MODE=lists|labels  (default: lists)
STATE_MODE=lists

# SAFE_PRUNE=true|false  (default: true)
# When true, archive sc-* cards whose story is gone only if
# dateLastActivity is before local midnight today.
SAFE_PRUNE=true

# Owner Trello label colors: comma-separated name:color pairs.
# Keys match owner display names case-insensitively as substrings
# (e.g. ryan matches "Ryan", oyvind/øyvind matches "Øyvind").
# Unmatched owners use the default. Defaults avoid priority colors.
# OWNER_LABEL_COLORS=ryan:green,øyvind:purple,oyvind:purple
# OWNER_LABEL_COLOR_DEFAULT=lime

# Priority → Trello label colors (closest to Shortcut UI).
# Keys match priority strings case-insensitively (exact).
# None / empty / "-" → no priority label (priority: still in description).
# PRIORITY_LABEL_COLORS=Highest:red,High:pink,Medium:orange,Low:sky,Lowest:blue
