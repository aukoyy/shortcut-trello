# Required — Shortcut
SHORTCUT_API_TOKEN=
SHORTCUT_OWNER_ID=

# Required — Trello
# KEY = Power-Up API key. TOKEN = generated user Token (not the OAuth Secret).
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=

# Optional
# STATE_MODE=lists|labels  (default: lists)
STATE_MODE=lists

# SAFE_PRUNE=true|false  (default: true)
# When true, archive sc-* cards whose story is gone only if
# dateLastActivity is before local midnight today.
SAFE_PRUNE=true
