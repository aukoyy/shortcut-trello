# Required — Shortcut
SHORTCUT_API_TOKEN=
SHORTCUT_OWNER_ID=

# Required — Trello
# KEY = Power-Up API key. TOKEN = generated user Token (not the OAuth Secret).
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=

# Optional
# STATE_MODE=lists|labels  (default: lists)
STATE_MODE=lists

# SAFE_PRUNE=true|false  (default: true)
# When true, archive sc-* cards whose story is gone only if
# dateLastActivity is before local midnight today.
SAFE_PRUNE=true

# Owner Trello label colors: comma-separated name:color pairs.
# Keys match owner display names case-insensitively as substrings
# (e.g. ryan matches "Ryan", oyvind/øyvind matches "Øyvind").
# Trello cannot use custom OKLCH/hex — only presets. Defaults are the
# closest presets to Shortcut UI (Øyvind hue~152→green, Ryan hue~129→lime).
# Unmatched owners use purple (free preset; avoids priority colors).
# OWNER_LABEL_COLORS=ryan:lime,øyvind:green,oyvind:green
# OWNER_LABEL_COLOR_DEFAULT=purple

# Priority → Trello label colors (closest presets to Shortcut OKLCH).
# Keys match priority strings case-insensitively (exact).
# Medium hue~92 → yellow (not orange). None / empty / "-" → no priority label
# (priority: still in description).
# PRIORITY_LABEL_COLORS=Highest:red,High:pink,Medium:yellow,Low:sky,Lowest:blue
